{
    "name": "csv-table-editor",
    "displayName": "CSV Table Editor",
    "author": "zeco",
    "publisher": "zeco",
    "description": "%extension.description%",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.146.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "customEditors": [
            {
                "viewType": "csv-table-editor.table",
                "displayName": "CSV Table Editor",
                "selector": [
                    { "filenamePattern": "*.csv" },
                    { "filenamePattern": "*.tsv" }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "csv-table-editor.selectDelimiter",
                "title": "%command.selectDelimiter%"
            },
            {
                "command": "csv-table-editor.toggleTextWrapping",
                "title": "%command.toggleTextWrapping%",
                "icon": "$(word-wrap)"
            },
            {
                "title": "%command.editCell%",
                "command": "csv-table-editor.editCell",
                "enablement": "true"
            },
            {
                "title": "%command.clearCell%",
                "command": "csv-table-editor.clearCell",
                "enablement": "true"
            },
            {
                "title": "%command.clearFilter%",
                "command": "csv-table-editor.clearFilter",
                "enablement": "true"
            },
            {
                "title": "%command.resetAllFilters%",
                "command": "csv-table-editor.resetAllFilters",
                "enablement": "true"
            },
            {
                "title": "%command.freezeCell%",
                "command": "csv-table-editor.freezeCell",
                "enablement": "true"
            },
            {
                "title": "%command.unfreezeCell%",
                "command": "csv-table-editor.unfreezeCell",
                "enablement": "true"
            },
            {
                "title": "%command.insertRowAbove%",
                "command": "csv-table-editor.insertRowAbove",
                "enablement": "true"
            },
            {
                "title": "%command.insertRowBelow%",
                "command": "csv-table-editor.insertRowBelow",
                "enablement": "true"
            },
            {
                "title": "%command.insertColumnLeft%",
                "command": "csv-table-editor.insertColumnLeft",
                "enablement": "true"
            },
            {
                "title": "%command.insertColumnRight%",
                "command": "csv-table-editor.insertColumnRight",
                "enablement": "true"
            },
            {
                "title": "%command.deleteRow%",
                "command": "csv-table-editor.deleteRow",
                "enablement": "true"
            },
            {
                "title": "%command.deleteColumn%",
                "command": "csv-table-editor.deleteColumn",
                "enablement": "true"
            },
            {
                "title": "%command.clearAndReloadTable%",
                "command": "csv-table-editor.clearAndReloadTable",
                "enablement": "true"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "csv-table-editor.toggleTextWrapping",
                    "when": "activeCustomEditorId == 'csv-table-editor.table'",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                { "command": "csv-table-editor.toggleTextWrapping", "when": "false" },
                { "command": "csv-table-editor.editCell", "when": "false" },
                { "command": "csv-table-editor.clearCell", "when": "false" },
                { "command": "csv-table-editor.clearFilter", "when": "false" },
                { "command": "csv-table-editor.resetAllFilters", "when": "false" },
                { "command": "csv-table-editor.freezeCell", "when": "false" },
                { "command": "csv-table-editor.unfreezeCell", "when": "false" },
                { "command": "csv-table-editor.insertRowAbove", "when": "false" },
                { "command": "csv-table-editor.insertRowBelow", "when": "false" },
                { "command": "csv-table-editor.insertColumnLeft", "when": "false" },
                { "command": "csv-table-editor.insertColumnRight", "when": "false" },
                { "command": "csv-table-editor.deleteRow", "when": "false" },
                { "command": "csv-table-editor.deleteColumn", "when": "false" },
                { "command": "csv-table-editor.clearAndReloadTable", "when": "false" }
            ],
            "webview/context": [
                {
                    "command": "csv-table-editor.editCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell'",
                    "group": "1_cell@1"
                },
                {
                    "command": "csv-table-editor.clearCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell'",
                    "group": "1_cell@2"
                },
                {
                    "command": "csv-table-editor.clearFilter",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'header')",
                    "group": "2_filter@1"
                },
                {
                    "command": "csv-table-editor.resetAllFilters",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'header'",
                    "group": "2_filter@2"
                },
                {
                    "command": "csv-table-editor.freezeCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell'",
                    "group": "3_freeze@1"
                },
                {
                    "command": "csv-table-editor.unfreezeCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell' && hasFrozenColumns",
                    "group": "3_freeze@2"
                },
                {
                    "command": "csv-table-editor.insertRowAbove",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'row')",
                    "group": "4_row@1"
                },
                {
                    "command": "csv-table-editor.insertRowBelow",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'row')",
                    "group": "4_row@2"
                },
                {
                    "command": "csv-table-editor.insertColumnLeft",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'header')",
                    "group": "5_column@1"
                },
                {
                    "command": "csv-table-editor.insertColumnRight",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'header')",
                    "group": "5_column@2"
                },
                {
                    "command": "csv-table-editor.deleteRow",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'row')",
                    "group": "6_delete@1"
                },
                {
                    "command": "csv-table-editor.deleteColumn",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'header')",
                    "group": "6_delete@2"
                },
                {
                    "command": "csv-table-editor.clearAndReloadTable",
                    "when": "webviewId == 'csv-table-editor.table'",
                    "group": "6_delete@3"
                }
            ]
        },
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "csv-table-editor.cellMaxCell": {
                    "type": "number",
                    "default": 400,
                    "minimum": 1,
                    "order": 1,
                    "description": "%configuration.cellMaxCell.description%"
                },
                "csv-table-editor.tableHeader": {
                    "type": "boolean",
                    "default": true,
                    "order": 2,
                    "description": "%configuration.tableHeader.description%"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write src esbuild.js",
        "format:check": "prettier --check src esbuild.js",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/papaparse": "^5.5.2",
        "@types/tabulator-tables": "^6.3.6",
        "@types/vscode": "^1.146.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "papaparse": "^5.7.1",
        "tabulator-tables": "^6.7.1"
    }
}
