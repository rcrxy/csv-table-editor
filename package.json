{
    "name": "delimgrid",
    "displayName": "DelimGrid",
    "author": "zeco",
    "license": "SEE LICENSE IN LICENSE",
    "publisher": "zeco",
    "description": "%extension.description%",
    "version": "0.1.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/rcrxy/csv-table-editor.git"
    },
    "engines": {
        "vscode": "^1.146.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "l10n": "./l10n",
    "contributes": {
        "customEditors": [
            {
                "viewType": "csv-table-editor.table",
                "displayName": "DelimGrid",
                "selector": [
                    {
                        "filenamePattern": "*.csv"
                    },
                    {
                        "filenamePattern": "*.tsv"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "delimgrid.selectDelimiter",
                "title": "%command.selectDelimiter%"
            },
            {
                "command": "delimgrid.toggleTextWrapping",
                "title": "%command.toggleTextWrapping%",
                "icon": "$(word-wrap)"
            },
            {
                "title": "%command.editCell%",
                "command": "delimgrid.editCell",
                "enablement": "true"
            },
            {
                "command": "delimgrid.moveCellSelection",
                "title": "%command.moveCellSelection%"
            },
            {
                "command": "delimgrid.moveRowUp",
                "title": "%command.moveRowUp%"
            },
            {
                "command": "delimgrid.moveRowDown",
                "title": "%command.moveRowDown%"
            },
            {
                "command": "delimgrid.moveColumnLeft",
                "title": "%command.moveColumnLeft%"
            },
            {
                "command": "delimgrid.moveColumnRight",
                "title": "%command.moveColumnRight%"
            },
            {
                "command": "delimgrid.submitCellEdit",
                "title": "%command.submitCellEdit%"
            },
            {
                "command": "delimgrid.cancelCellEdit",
                "title": "%command.cancelCellEdit%"
            },
            {
                "command": "delimgrid.undoCellEdit",
                "title": "%command.undoCellEdit%"
            },
            {
                "command": "delimgrid.redoCellEdit",
                "title": "%command.redoCellEdit%"
            },
            {
                "command": "delimgrid.insertCellLineBreak",
                "title": "%command.insertCellLineBreak%"
            },
            {
                "title": "%command.clearCell%",
                "command": "delimgrid.clearCell",
                "enablement": "true"
            },
            {
                "command": "delimgrid.copyTableRange",
                "title": "%command.copyTableRange%"
            },
            {
                "command": "delimgrid.pasteTableColumn",
                "title": "%command.pasteTableColumn%"
            },
            {
                "title": "%command.clearFilter%",
                "command": "delimgrid.clearFilter",
                "enablement": "true"
            },
            {
                "title": "%command.resetAllFilters%",
                "command": "delimgrid.resetAllFilters",
                "enablement": "true"
            },
            {
                "title": "%command.freezeCell%",
                "command": "delimgrid.freezeCell",
                "enablement": "true"
            },
            {
                "title": "%command.unfreezeCell%",
                "command": "delimgrid.unfreezeCell",
                "enablement": "true"
            },
            {
                "title": "%command.insertRowAbove%",
                "command": "delimgrid.insertRowAbove",
                "enablement": "true"
            },
            {
                "title": "%command.insertRowBelow%",
                "command": "delimgrid.insertRowBelow",
                "enablement": "true"
            },
            {
                "title": "%command.insertColumnLeft%",
                "command": "delimgrid.insertColumnLeft",
                "enablement": "true"
            },
            {
                "title": "%command.insertColumnRight%",
                "command": "delimgrid.insertColumnRight",
                "enablement": "true"
            },
            {
                "title": "%command.deleteRow%",
                "command": "delimgrid.deleteRow",
                "enablement": "true"
            },
            {
                "title": "%command.deleteColumn%",
                "command": "delimgrid.deleteColumn",
                "enablement": "true"
            },
            {
                "title": "%command.clearAndReloadTable%",
                "command": "delimgrid.clearAndReloadTable",
                "enablement": "true"
            }
        ],
        "keybindings": [
            {
                "command": "delimgrid.moveCellSelection",
                "key": "up",
                "args": "up",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'grid'"
            },
            {
                "command": "delimgrid.moveCellSelection",
                "key": "down",
                "args": "down",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'grid'"
            },
            {
                "command": "delimgrid.moveCellSelection",
                "key": "left",
                "args": "left",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'grid'"
            },
            {
                "command": "delimgrid.moveCellSelection",
                "key": "right",
                "args": "right",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'grid'"
            },
            {
                "command": "delimgrid.editCell",
                "key": "enter",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'grid'"
            },
            {
                "command": "delimgrid.clearCell",
                "key": "delete",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.canMoveTableStructure"
            },
            {
                "command": "delimgrid.insertCellLineBreak",
                "key": "enter",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'editing'"
            },
            {
                "command": "delimgrid.insertCellLineBreak",
                "key": "shift+enter",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'editing'"
            },
            {
                "command": "delimgrid.submitCellEdit",
                "key": "ctrl+enter",
                "args": true,
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'editing'"
            },
            {
                "command": "delimgrid.cancelCellEdit",
                "key": "escape",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode == 'editing'"
            },
            {
                "command": "delimgrid.undoCellEdit",
                "key": "ctrl+z",
                "mac": "cmd+z",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode =~ /^(editing|composing)$/"
            },
            {
                "command": "delimgrid.redoCellEdit",
                "key": "ctrl+y",
                "mac": "cmd+shift+z",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode =~ /^(editing|composing)$/"
            },
            {
                "command": "delimgrid.redoCellEdit",
                "key": "ctrl+shift+z",
                "when": "!isMac && activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.keyboardMode =~ /^(editing|composing)$/"
            },
            {
                "command": "delimgrid.moveRowUp",
                "key": "alt+up",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.canMoveTableStructure"
            },
            {
                "command": "delimgrid.moveRowDown",
                "key": "alt+down",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.canMoveTableStructure"
            },
            {
                "command": "delimgrid.moveColumnLeft",
                "key": "alt+left",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.canMoveTableStructure"
            },
            {
                "command": "delimgrid.moveColumnRight",
                "key": "alt+right",
                "when": "activeCustomEditorId == 'csv-table-editor.table' && csvTableEditor.canMoveTableStructure"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "delimgrid.toggleTextWrapping",
                    "when": "activeCustomEditorId == 'csv-table-editor.table'",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "delimgrid.toggleTextWrapping",
                    "when": "false"
                },
                {
                    "command": "delimgrid.editCell",
                    "when": "false"
                },
                {
                    "command": "delimgrid.moveCellSelection",
                    "when": "false"
                },
                {
                    "command": "delimgrid.moveRowUp",
                    "when": "false"
                },
                {
                    "command": "delimgrid.moveRowDown",
                    "when": "false"
                },
                {
                    "command": "delimgrid.moveColumnLeft",
                    "when": "false"
                },
                {
                    "command": "delimgrid.moveColumnRight",
                    "when": "false"
                },
                {
                    "command": "delimgrid.submitCellEdit",
                    "when": "false"
                },
                {
                    "command": "delimgrid.cancelCellEdit",
                    "when": "false"
                },
                {
                    "command": "delimgrid.undoCellEdit",
                    "when": "false"
                },
                {
                    "command": "delimgrid.redoCellEdit",
                    "when": "false"
                },
                {
                    "command": "delimgrid.insertCellLineBreak",
                    "when": "false"
                },
                {
                    "command": "delimgrid.clearCell",
                    "when": "false"
                },
                {
                    "command": "delimgrid.copyTableRange",
                    "when": "false"
                },
                {
                    "command": "delimgrid.pasteTableColumn",
                    "when": "false"
                },
                {
                    "command": "delimgrid.clearFilter",
                    "when": "false"
                },
                {
                    "command": "delimgrid.resetAllFilters",
                    "when": "false"
                },
                {
                    "command": "delimgrid.freezeCell",
                    "when": "false"
                },
                {
                    "command": "delimgrid.unfreezeCell",
                    "when": "false"
                },
                {
                    "command": "delimgrid.insertRowAbove",
                    "when": "false"
                },
                {
                    "command": "delimgrid.insertRowBelow",
                    "when": "false"
                },
                {
                    "command": "delimgrid.insertColumnLeft",
                    "when": "false"
                },
                {
                    "command": "delimgrid.insertColumnRight",
                    "when": "false"
                },
                {
                    "command": "delimgrid.deleteRow",
                    "when": "false"
                },
                {
                    "command": "delimgrid.deleteColumn",
                    "when": "false"
                },
                {
                    "command": "delimgrid.clearAndReloadTable",
                    "when": "false"
                }
            ],
            "webview/context": [
                {
                    "command": "delimgrid.editCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell'",
                    "group": "1_cell@1"
                },
                {
                    "command": "delimgrid.clearCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell'",
                    "group": "1_cell@2"
                },
                {
                    "command": "delimgrid.freezeCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell' && canFreezePanes",
                    "group": "3_freeze@1"
                },
                {
                    "command": "delimgrid.unfreezeCell",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'cell' && hasFrozenPanes",
                    "group": "3_freeze@2"
                },
                {
                    "command": "delimgrid.insertRowAbove",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'row')",
                    "group": "4_row@1"
                },
                {
                    "command": "delimgrid.insertRowBelow",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'row')",
                    "group": "4_row@2"
                },
                {
                    "command": "delimgrid.insertColumnLeft",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'header')",
                    "group": "5_column@1"
                },
                {
                    "command": "delimgrid.insertColumnRight",
                    "when": "webviewId == 'csv-table-editor.table' && (webviewSection == 'cell' || webviewSection == 'header')",
                    "group": "5_column@2"
                },
                {
                    "command": "delimgrid.copyTableRange",
                    "when": "webviewId == 'csv-table-editor.table' && canCopyTableRange",
                    "group": "5_cutcopypaste@2"
                },
                {
                    "command": "delimgrid.pasteTableColumn",
                    "when": "webviewId == 'csv-table-editor.table' && webviewSection == 'header' && canPasteTableColumn",
                    "group": "5_cutcopypaste@3"
                },
                {
                    "command": "delimgrid.deleteRow",
                    "when": "webviewId == 'csv-table-editor.table' && canDeleteTableRow",
                    "group": "6_delete@1"
                },
                {
                    "command": "delimgrid.deleteColumn",
                    "when": "webviewId == 'csv-table-editor.table' && canDeleteTableColumn",
                    "group": "6_delete@2"
                },
                {
                    "command": "delimgrid.clearAndReloadTable",
                    "when": "webviewId == 'csv-table-editor.table'",
                    "group": "6_delete@3"
                }
            ]
        },
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "csv-table-editor.cellMaxCell": {
                    "type": "number",
                    "default": 400,
                    "minimum": 1,
                    "order": 1,
                    "description": "%configuration.cellMaxCell.description%"
                },
                "csv-table-editor.tableHeader": {
                    "type": "boolean",
                    "default": true,
                    "order": 2,
                    "description": "%configuration.tableHeader.description%"
                },
                "csv-table-editor.showRowNumbers": {
                    "type": "boolean",
                    "default": true,
                    "order": 3,
                    "description": "%configuration.showRowNumbers.description%"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "package:vsix": "npx --yes @vscode/vsce package --no-dependencies",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write src esbuild.js",
        "format:check": "prettier --check src esbuild.js",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/papaparse": "^5.5.2",
        "@types/tabulator-tables": "^6.3.6",
        "@types/vscode": "^1.146.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "papaparse": "^5.7.1",
        "tabulator-tables": "^6.7.1"
    }
}
